---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { apps, appPath } from "../data/apps";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.year - a.data.year || a.id.localeCompare(b.id),
);
const pastYears = [...new Set(projects.filter((project) => !project.data.current).map((project) => project.data.year))];
const groups = [
  { id: "current", label: "現在", includes: (project: (typeof projects)[number]) => project.data.current },
  ...pastYears.map((year) => ({
    id: `${year}`,
    label: `${year}`,
    includes: (project: (typeof projects)[number]) => !project.data.current && project.data.year === year,
  })),
];

const rendered = await Promise.all(
  projects.map(async (project) => ({
    project,
    app: apps.find((app) => app.slug === project.data.app),
    Content: (await render(project)).Content,
  })),
);
---

<Base title="開発事例と技術スタック">
  <main class="wrap">
    <div class="intro">
      <h1>開発事例と技術スタック</h1>
      <p>
        お仕事のご相談は <a href="mailto:kanagu@kingu.dev">kanagu@kingu.dev</a> までご連絡ください。
      </p>
      <p class="muted small">各年はプロジェクトの開始時期を示しています。</p>
    </div>

    {
      groups.map((group) => (
        <section class="year-group" id={group.id}>
          <div class="year">{group.label}</div>
          <div class="projects">
            {rendered
              .filter(({ project }) => group.includes(project))
              .map(({ project, app, Content }) => (
                <article class="project" id={project.id}>
                  <header>
                    {app && (
                      <a href={appPath(app)}>
                        <img class="icon" src={app.icon} alt="" />
                      </a>
                    )}
                    <div>
                      {project.data.personal && <span class="tag">個人開発</span>}
                      <h2>{app ? <a href={appPath(app)}>{project.data.title}</a> : project.data.title}</h2>
                    </div>
                  </header>
                  <div class="body">
                    <Content />
                  </div>
                  {project.data.stack.length > 0 && (
                    <ul class="stack">
                      {project.data.stack.map((item) =>
                        typeof item === "string" ? (
                          <li>{item}</li>
                        ) : (
                          <li>
                            {item.name}
                            <span class="sub">{item.items.join(" · ")}</span>
                          </li>
                        ),
                      )}
                    </ul>
                  )}
                </article>
              ))}
          </div>
        </section>
      ))
    }
  </main>
</Base>

<style>
  .intro {
    padding: 64px 0 48px;
  }

  h1 {
    font-size: 36px;
    line-height: 1.15;
    font-weight: 500;
    margin: 0 0 16px;
  }

  .intro p {
    margin: 0 0 4px;
    color: var(--text-secondary);
  }

  .year-group {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 32px;
    padding: 32px 0;
    border-top: 1px solid var(--hairline);
  }

  .year {
    position: sticky;
    top: 88px;
    align-self: start;
    font-family: var(--mono);
    font-size: 15px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .projects {
    display: grid;
    gap: 16px;
  }

  .project {
    padding: 24px;
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: 16px;
    overflow-wrap: anywhere;
  }

  header {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 12px;
  }

  .icon {
    width: 48px;
    height: 48px;
    border-radius: 22%;
    display: block;
  }

  .tag {
    display: inline-block;
    font-size: 12px;
    line-height: 16px;
    color: var(--accent);
    margin-bottom: 2px;
  }

  h2 {
    font-size: 17px;
    line-height: 1.5;
    font-weight: 500;
    margin: 0;
  }

  h2 a {
    color: var(--text);
  }

  h2 a:hover {
    color: var(--accent);
  }

  .body :global(p) {
    margin: 0 0 8px;
    color: var(--text-secondary);
  }

  .body :global(ul) {
    margin: 0;
    padding-left: 20px;
    color: var(--text-secondary);
  }

  .body :global(details) {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
  }

  .body :global(summary) {
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .body :global(details[open] summary) {
    margin-bottom: 8px;
  }

  .body :global(.toolkit) {
    margin: 16px 0 0;
    font-size: 13px;
    line-height: 1.6;
  }

  .body :global(.toolkit span) {
    display: block;
    margin-bottom: 4px;
    font-size: 12px;
    color: var(--accent);
  }

  .body :global(.toolkit ul) {
    margin: 0;
    padding-left: 16px;
    color: var(--text);
  }

  .body :global(.toolkit li + li) {
    margin-top: 4px;
  }

  .body :global(.toolkit code) {
    display: block;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-secondary);
  }

  .body :global(.toolkit .tk-snapshot) {
    margin: 0 0 8px;
    text-align: right;
    font-size: 12px;
    color: var(--text-muted);
  }

  .body :global(.tk-repo) {
    padding: 16px;
    border: 1px solid var(--accent);
    border-radius: 12px;
  }

  .body :global(.toolkit .tk-title) {
    margin: 0 0 12px;
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .body :global(.tk-cols) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      "rules dev improve"
      "hooks dev improve";
    gap: 12px;
  }

  .body :global(.tk-cols > :nth-child(1)) {
    grid-area: rules;
  }

  .body :global(.tk-cols > :nth-child(2)) {
    grid-area: dev;
  }

  .body :global(.tk-cols > :nth-child(3)) {
    grid-area: improve;
  }

  .body :global(.tk-cols > :nth-child(4)) {
    grid-area: hooks;
  }

  .body :global(.tk-cols > div) {
    padding: 12px;
    background: var(--raised);
    border-radius: 8px;
  }

  .body :global(.toolkit .tk-link) {
    margin: 8px 0;
    text-align: center;
    font-size: 12px;
    color: var(--text-muted);
  }

  .body :global(.tk-steps) {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .body :global(.tk-steps li) {
    position: relative;
    margin: 0;
    padding: 12px;
    background: var(--raised);
    border-radius: 8px;
    color: var(--text);
  }

  .body :global(.tk-back li) {
    background: none;
    border: 1px dashed var(--accent);
  }

  .body :global(.tk-steps li:not(:last-child)::after) {
    content: "→";
    position: absolute;
    top: 50%;
    right: -18px;
    transform: translateY(-50%);
    color: var(--text-muted);
  }

  .body :global(.twitter-tweet) {
    margin: 12px 0;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
  }

  .stack li {
    font-size: 12px;
    line-height: 16px;
    padding: 4px 8px;
    background: var(--raised);
    border-radius: 6px;
    color: var(--text-secondary);
  }

  .sub {
    color: var(--text-muted);
    margin-left: 4px;
  }

  @media (max-width: 800px) {
    .intro {
      padding: 32px 0 24px;
    }

    .year-group {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .year {
      position: static;
    }

    .project {
      padding: 20px;
    }

    .body :global(.tk-cols) {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "rules" "dev" "improve" "hooks";
    }

    .body :global(.tk-steps) {
      grid-auto-flow: row;
      gap: 24px;
    }

    .body :global(.tk-steps li:not(:last-child)::after) {
      content: "↓";
      top: auto;
      right: auto;
      left: 50%;
      bottom: -22px;
      transform: translateX(-50%);
    }
  }
</style>

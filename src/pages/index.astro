---
import Base from "../layouts/Base.astro";
import FeaturedBadges from "../components/FeaturedBadges.astro";
import { apps, appPath, type App } from "../data/apps";

const awards = [
  {
    year: "2025",
    entries: [
      {
        title: "AI Agent Hackathon with Google Cloud",
        body: 'Zenn が主催するハッカソンにて、<a href="/technology-stack/#2025-01-blooms">BLOOMS</a> が <strong>Firebase 賞</strong>を受賞しました。',
        refs: [
          {
            href: "https://zenn.dev/hackathons/2024-google-cloud-japan-ai-hackathon",
            label: "【Zenn 初開催】AI エージェント開発に挑戦！初心者歓迎ハッカソン",
          },
        ],
      },
    ],
  },
  {
    year: "2016",
    entries: [
      {
        title: "東京駅周辺の魅力向上サービス創造ハッカソン — 高精度測位社会を目指して",
        body: "国土交通省が主催するハッカソンにて、<strong>慶應義塾大学大学院 SDM 研究科委員長賞</strong>と<strong>高精度測位社会プロジェクト賞</strong>を受賞しました。",
        refs: [
          {
            href: "https://qzss.go.jp/info/archive/tokyo_160208.html",
            label: "東京駅周辺の魅力向上を目指すハッカソン、国交省が開催｜関連ニュース｜みちびき（準天頂衛星システム：QZSS）公式サイト - 内閣府",
          },
        ],
      },
    ],
  },
  {
    year: "2015",
    entries: [
      {
        title: "UWW2015",
        body: "ワークショップにて、<strong>ベストプレゼンテーション賞</strong>を受賞しました。",
        refs: [
          {
            label: '金具 浩平，望月 祐洋，村尾 和哉，西尾 信彦: "Fireman Dead Reckoning: 屋内における消防士向け自律航法の検討" ユビキタス・ウェアラブルワークショップ, （UWW2015）予稿集, p.37, 2015 年 12 月 19 日, ベストプレゼンテーション賞',
          },
        ],
      },
      {
        title: "DICOMO 2015",
        body: "学会にて、<strong>ヤングリサーチャー賞</strong>を受賞しました。",
        refs: [
          {
            href: "https://www.dicomo.org/2015/2015/commendation/index.html",
            label: "表彰 « DICOMO",
          },
          {
            label: '吉見 駿, 金具 浩平, 望月 祐洋, 村尾 和哉, 西尾 信彦: "実環境における歩行空間制約を活用した PDR 軌跡推定" 情報処理学会, マルチメディア, 分散, 協調とモバイル(DICOMO 2015) シンポジウム論文集, pp.310-318, 2015 年 7 月 8 日, ヤングリサーチャー賞',
          },
        ],
      },
    ],
  },
  {
    year: "2013",
    entries: [
      {
        title: "京都まゆまろ杯 第１回スマホアプリコンテスト",
        body: "スマートフォン向けアプリ開発コンテストにて、<strong>ピー･シー･フェーズ賞</strong>を受賞しました。",
        refs: [
          {
            href: "https://web.archive.org/web/20130702073500/http://cts-1.sakura.ne.jp/client/mayumaro/index.html",
            label: "京都まゆまろ杯 第 1 回スマホアプリコンテスト",
          },
          {
            href: "https://web.archive.org/web/20130702073456/http://cts-1.sakura.ne.jp:80/client/mayumaro/award.html",
            label: "京都まゆまろ杯 第 1 回スマホアプリコンテスト | 受賞作品結果一覧",
          },
        ],
      },
    ],
  },
  {
    year: "2012",
    entries: [
      {
        title: "ICT Challenge+R 2012",
        body: "立命館大学が主催するプログラミングコンテストにて、<strong>最優秀賞</strong>を受賞しました。",
        refs: [
          {
            href: "https://www.ritsumei.ac.jp/rs/category/r_na_hito/entry/?param=474",
            label: "金具浩平さん(情報理工学部 2 回生)/ICT Challenge+R 2011 で ISID イノラボ賞、ICTChallenge+R NEXT 2012 で最優秀賞を受賞！| +R な人｜立命館大学",
          },
        ],
      },
    ],
  },
  {
    year: "2011",
    entries: [
      {
        title: "ICT Challenge+R 2011",
        body: "立命館大学が主催するプログラミングコンテストにて、<strong>ISID イノラボ賞</strong>を受賞しました。",
        refs: [
          {
            href: "https://www.ritsumei.ac.jp/rs/category/r_na_hito/entry/?param=474",
            label: "金具浩平さん(情報理工学部 2 回生)/ICT Challenge+R 2011 で ISID イノラボ賞、ICTChallenge+R NEXT 2012 で最優秀賞を受賞！| +R な人｜立命館大学",
          },
        ],
      },
    ],
  },
];

const papers = [
  {
    heading: "国際会議論文",
    items: [
      'Kohei Kanagu, Kota Tsubouchi and Nobuhiko Nishio, "Colorful PDR: Colorizing PDR with Shopping Context in Walking", IPIN2017, Hokkaido, Japan., Sep, 2017.',
      'Shun Yoshimi, Kohei Kanagu, Masahiro Mochizuki, Kazuya Murao, and Nobuhiko Nishio, "PDR Trajectory Estimation using Pedestrian-Space Constraints: Real World Evaluations", HASCA2015, Osaka, Japan, Sep, 2015.',
    ],
  },
  {
    heading: "国際学会",
    items: [
      'Takumi Otsuki, Kohei Kanagu, Kota Tsubouchi, Nobuhiko Nishio, "Daily action dead reckoning using smartphone sensors", 10th International Conference on Indoor Positioning and Indoor Navigation (IPIN 2019), Italy, Oct, 2019',
    ],
  },
  {
    heading: "国内研究会・シンポジウム等",
    items: [
      '金具 浩平, 川内 菜津美, 大槻 拓未, 西尾 信彦: "屋内空間における係留状態認識, 情報処理学会, マルチメディア, 分散, 協調とモバイル(DICOMO 2018)シンポジウム論文集, pp.94-99, 2018 年 7 月 4 日.',
      '金具 浩平，望月 祐洋，村尾 和哉，西尾 信彦: "Fireman Dead Reckoning: 屋内における消防士向け自律航法の検討" ユビキタス・ウェアラブルワークショップ, （UWW2015）予稿集, p.37, 2015 年 12 月 19 日, ベストプレゼンテーション賞',
      '吉見 駿, 金具 浩平, 望月 祐洋, 村尾 和哉, 西尾 信彦: "実環境における歩行空間制約を活用した PDR 軌跡推定" 情報処理学会, マルチメディア, 分散, 協調とモバイル(DICOMO 2015) シンポジウム論文集, pp.310-318, 2015 年 7 月 8 日, ヤングリサーチャー賞',
    ],
  },
];

const steamReplays = [
  { year: "2022", href: "https://s.team/y22/dngcjfm" },
  { year: "2023", href: "https://s.team/y23/dngcjfm" },
  { year: "2024", href: "https://s.team/y24/dngcjfm" },
];

const appAnchor = (app: App) => `app-${app.slug.replaceAll(" ", "-")}`;
---

<Base title="金具 浩平 (KANAGU Kohei)">
  <main class="wrap">
    <div class="intro" id="work">
      <div>
        <h1>金具 浩平</h1>
        <p class="latin">KANAGU Kohei</p>
        <p class="lead">
          お仕事のご相談は <a href="mailto:kanagu@kingu.dev">kanagu@kingu.dev</a> までご連絡ください。
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="mailto:kanagu@kingu.dev">メールで相談する</a>
          <a class="btn btn-secondary" href="/technology-stack/">過去の開発事例と技術スタック</a>
        </div>
      </div>
      <div class="icon-shelf">
        {
          apps.map((app) => (
            <a href={`#${appAnchor(app)}`}>
              <img src={app.icon} alt={app.name} />
            </a>
          ))
        }
        <span class="caption">公開中の個人開発アプリ {apps.length}本</span>
      </div>
    </div>

    <section id="awards">
      <div class="section-head">
        <h2>受賞歴等</h2>
        <div class="timeline">
          {
            awards.map((award) => (
              <>
                <div class="year">{award.year}</div>
                <div class="entries">
                  {award.entries.map((entry) => (
                    <div class="entry">
                      <h3>{entry.title}</h3>
                      <p set:html={entry.body} />
                      <ul class="plain">
                        {entry.refs.map((ref) => (
                          <li>{ref.href ? <a href={ref.href}>{ref.label}</a> : ref.label}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </>
            ))
          }
        </div>
      </div>
    </section>

    <section id="made">
      <div class="section-head">
        <h2>開発したもの</h2>
        <div>
          <div class="rows">
            <a href="https://github.com/KoheiKanagu"><span>リポジトリ</span><span class="meta">github.com/KoheiKanagu</span></a>
            <a href="https://pub.dev/publishers/kingu.dev/packages"><span>パッケージ</span><span class="meta">pub.dev/publishers/kingu.dev</span></a>
          </div>

          <h4 id="個人開発のアプリ">個人開発のアプリ（公開中のもののみ）</h4>
          <div class="apps">
            {
              apps.map((app) => (
                <div class="app" id={appAnchor(app)}>
                  <a href={appPath(app)}>
                    <img src={app.icon} alt="" />
                  </a>
                  <div>
                    <h3>
                      <a href={appPath(app)}>{app.name}</a>
                    </h3>
                    {app.tagline && <div class="small muted">{app.tagline}</div>}
                    <div class="badges">
                      <a href={app.appStoreUrl}>
                        <img src="/images/app_store.svg" alt="App Store" />
                      </a>
                      {app.googlePlayUrl && (
                        <a href={app.googlePlayUrl}>
                          <img src="/images/google_play.webp" alt="Google Play" />
                        </a>
                      )}
                      <FeaturedBadges app={app} />
                    </div>
                    {app.sourceUrl && (
                      <a class="source" href={app.sourceUrl}>
                        ソースコード
                      </a>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="sns">
      <div class="section-head">
        <h2>SNS</h2>
        <div>
          <div class="rows">
            <a href="https://twitter.com/i_am_kingu_pub"><span>X</span><span class="meta">@i_am_kingu_pub</span></a>
            <a href="https://www.facebook.com/k.g.kohei"><span>Facebook</span><span class="meta">k.g.kohei</span></a>
          </div>
          <h4>モル旅</h4>
          <div class="rows">
            <a href="https://x.com/search?q=-%23%E5%BC%81%E5%BD%93%20(%23%E3%83%A2%E3%83%AB%E3%82%AB%E3%83%BC)%20(from%3Ai_am_kingu_pub)%20until%3A2024-02-19%20since%3A2024-02-16&src=typed_query&f=live"><span>広島</span><span class="meta">2024/02</span></a>
            <a href="https://x.com/search?q=-%23%E3%81%8A%E5%BC%81%E5%BD%93%E8%A8%98%E9%8C%B2%20(%23%E3%83%A2%E3%83%AB%E3%82%AB%E3%83%BC)%20(from%3Ai_am_kingu_pub)%20until%3A2024-05-29%20since%3A2024-05-25&src=typed_query&f=live"><span>京都</span><span class="meta">2024/05</span></a>
          </div>
        </div>
      </div>
    </section>

    <section id="games">
      <div class="section-head">
        <h2>ゲーム</h2>
        <div>
          <div class="rows">
            <a href="https://steamcommunity.com/id/i_am_kingu"><span>Steam</span><span class="meta">i_am_kingu</span></a>
          </div>
          <div class="steam">
            {
              steamReplays.map((replay) => (
                <a href={replay.href}>
                  <img src={`/images/steam_replay_${replay.year}.webp`} alt={`steam replay ${replay.year}`} />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="writing">
      <div class="section-head">
        <h2>執筆</h2>
        <div>
          <div class="rows">
            <a href="https://zenn.dev/kingu"><span>Zenn</span><span class="meta">zenn.dev/kingu</span></a>
          </div>
          {
            papers.map((group) => (
              <>
                <h4>{group.heading}</h4>
                <ul class="plain papers">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
    padding: 96px 0 80px;
  }

  .intro h1 {
    font-size: 44px;
    line-height: 1.12;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 4px;
  }

  .latin {
    font-size: 18px;
    color: var(--text-muted);
    margin: 0 0 32px;
  }

  .lead {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0 0 32px;
    max-width: 30rem;
  }

  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .icon-shelf {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding: 32px;
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: 20px;
    box-shadow: 0 8px 24px var(--shadow);
  }

  .icon-shelf a {
    display: block;
  }

  .icon-shelf img {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 22%;
    display: block;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    transition: transform 150ms var(--ease);
  }

  .icon-shelf a:hover img {
    transform: translateY(-2px);
  }

  .caption {
    grid-column: 1 / -1;
    font-size: 13px;
    color: var(--text-muted);
    margin-top: -4px;
  }

  section {
    padding: 64px 0;
    border-top: 1px solid var(--hairline);
  }

  .section-head {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 32px;
  }

  h2 {
    font-size: 22px;
    font-weight: 500;
    margin: 0;
    line-height: 1.4;
  }

  h3 {
    font-size: 16px;
    font-weight: 500;
    margin: 0 0 4px;
  }

  h4 {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
    margin: 32px 0 12px;
  }

  ul.plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    column-gap: 24px;
    overflow-wrap: anywhere;
  }

  .year {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text-muted);
    padding-top: 4px;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
  }

  .entries {
    padding-bottom: 32px;
  }

  .entry + .entry {
    margin-top: 20px;
  }

  .entry p {
    margin: 0 0 8px;
    color: var(--text-secondary);
  }

  .entry li {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .entry li a {
    color: inherit;
  }

  .rows {
    display: grid;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 40px;
  }

  .rows a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    background: var(--card);
    color: var(--text);
  }

  .rows a:hover {
    background: var(--raised);
    text-decoration: none;
  }

  .meta {
    font-size: 13px;
    color: var(--text-muted);
  }

  .apps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .app {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 16px;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: 16px;
  }

  .app > a img {
    width: 72px;
    height: 72px;
    border-radius: 22%;
    display: block;
  }

  .app h3 a {
    color: var(--text);
  }

  .app h3 a:hover {
    color: var(--accent);
  }

  .app .badges {
    margin-top: 8px;
  }

  .source {
    font-size: 13px;
    margin-top: 8px;
    display: inline-block;
  }

  .steam {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 16px;
  }

  .steam img {
    width: 100%;
    border-radius: 12px;
    display: block;
    border: 1px solid var(--hairline);
  }

  .papers li {
    padding: 12px 0;
    border-top: 1px solid var(--hairline);
    font-size: 14px;
    color: var(--text-secondary);
  }

  .papers li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  @media (max-width: 800px) {
    .intro {
      grid-template-columns: 1fr;
      padding: 48px 0;
      gap: 32px;
    }

    .intro h1 {
      font-size: 36px;
    }

    .section-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .timeline {
      grid-template-columns: 48px minmax(0, 1fr);
      column-gap: 16px;
    }

    .apps,
    .steam {
      grid-template-columns: 1fr;
    }
  }
</style>

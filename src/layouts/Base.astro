---
import "../styles/global.css";

type Props = {
  title: string;
  ogImage?: string;
  appStoreId?: string;
};

const { title, ogImage = "/images/ogp.webp", appStoreId } = Astro.props;
const ogUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const nav = [
  { href: "/#work", label: "お仕事" },
  { href: "/#awards", label: "受賞歴" },
  { href: "/#made", label: "開発したもの" },
  { href: "/#sns", label: "SNS" },
  { href: "/#writing", label: "執筆" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta property="og:site_name" content="kingu.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={ogUrl} />
    {appStoreId && <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />}
    <link rel="icon" href="/images/favicon.webp" type="image/webp" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {}
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = stored ?? (prefersDark ? "dark" : "light");

        // widgets.js reads this when it renders embedded posts on the page.
        const tweetTheme = document.createElement("meta");
        tweetTheme.name = "twitter:widgets:theme";
        tweetTheme.content = document.documentElement.dataset.theme;
        document.head.append(tweetTheme);
      })();
    </script>
  </head>
  <body>
    <header>
      <div class="wrap">
        <a class="wordmark" href="/">kingu.dev</a>
        <div class="end">
          <nav>
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
          <button class="theme-toggle" type="button" aria-label="ライトモードとダークモードを切り替える">
            <svg class="only-light" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
            <svg class="only-dark" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer>
      <div class="wrap">
        <a href="/">kingu.dev</a>
      </div>
    </footer>
    <script>
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem("theme", theme);
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--hairline);
  }

  header .wrap {
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark {
    font-weight: 600;
    font-size: 16px;
    color: var(--text);
  }

  .wordmark:hover {
    text-decoration: none;
    color: var(--text);
  }

  .end {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  nav {
    display: flex;
    gap: 24px;
    font-size: 14px;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    background: var(--card);
    color: var(--text-secondary);
    cursor: pointer;
    transition: background-color 150ms var(--ease), color 150ms var(--ease);
  }

  .theme-toggle:hover {
    background: var(--raised);
    color: var(--text);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .theme-toggle svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  nav a {
    color: var(--text-secondary);
  }

  footer {
    margin-top: 64px;
    padding: 32px 0 48px;
    border-top: 1px solid var(--hairline);
    font-size: 13px;
  }

  footer a {
    color: var(--text-muted);
  }

  @media (max-width: 800px) {
    nav {
      display: none;
    }
  }
</style>

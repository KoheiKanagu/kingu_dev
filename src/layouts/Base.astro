---
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
  ogImage?: string;
  appStoreId?: string;
};

const { title, description = title, ogImage = "/images/ogp.webp", appStoreId } = Astro.props;
const ogUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const nav = [
  { href: "/#work", label: "お仕事" },
  { href: "/#cases", label: "開発事例" },
  { href: "/#made", label: "開発したもの" },
  { href: "/#awards", label: "受賞歴等" },
  { href: "/#writing", label: "執筆" },
  { href: "/#sns", label: "SNS" },
  { href: "/#games", label: "ゲーム" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta property="og:site_name" content="kingu.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={ogUrl} />
    {appStoreId && <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />}
    <link rel="icon" href="/images/favicon.webp" type="image/webp" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {}
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = stored ?? (prefersDark ? "dark" : "light");

        // widgets.js reads this when it renders embedded posts on the page.
        const tweetTheme = document.createElement("meta");
        tweetTheme.name = "twitter:widgets:theme";
        tweetTheme.content = document.documentElement.dataset.theme;
        document.head.append(tweetTheme);
      })();
    </script>
  </head>
  <body>
    <header>
      <div class="wrap">
        <a class="wordmark" href="/">kingu.dev</a>
        <div class="end">
          <nav>
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
          <button class="theme-toggle" type="button" aria-label="ライトモードとダークモードを切り替える">
            <svg class="only-light" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
            <svg class="only-dark" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer>
      <div class="wrap">
        <div class="contact">
          <h2 class="contact-title">お仕事のご相談</h2>
          <a class="btn btn-primary" href="mailto:kanagu@kingu.dev">メールで相談する</a>
          <p class="muted small">
            お仕事のご相談: <a href="mailto:kanagu@kingu.dev">kanagu@kingu.dev</a><br />
            アプリについてのお問い合わせ: <a href="mailto:support@kingu.dev">support@kingu.dev</a>
          </p>
        </div>
        <a class="home" href="/">kingu.dev</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const labelToggle = () => {
        const dark = document.documentElement.dataset.theme === "dark";
        toggle?.setAttribute("aria-label", dark ? "ライトモードに切り替える" : "ダークモードに切り替える");
      };
      labelToggle();
      const navLinks = [...document.querySelectorAll<HTMLAnchorElement>("header nav a")];
      const sections = navLinks
        .map((link) => document.getElementById(link.hash.slice(1)))
        .filter((section) => section !== null);
      if (location.pathname === "/" && sections.length > 0) {
        const markCurrent = () => {
          const current = sections.filter((section) => section.getBoundingClientRect().top <= 120).at(-1);
          for (const link of navLinks) {
            if (current && link.hash === `#${current.id}`) {
              link.setAttribute("aria-current", "location");
            } else {
              link.removeAttribute("aria-current");
            }
          }
        };
        markCurrent();
        addEventListener("scroll", markCurrent, { passive: true });
      }

      toggle?.addEventListener("click", () => {
        const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
        labelToggle();
        try {
          localStorage.setItem("theme", theme);
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--hairline);
  }

  header .wrap {
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark {
    font-weight: 600;
    font-size: 16px;
    color: var(--text);
  }

  .wordmark:hover {
    text-decoration: none;
    color: var(--text);
  }

  .end {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  nav {
    display: flex;
    gap: 24px;
    font-size: 14px;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    background: var(--card);
    color: var(--text-secondary);
    cursor: pointer;
    transition: background-color 150ms var(--ease), color 150ms var(--ease);
  }

  .theme-toggle:hover {
    background: var(--raised);
    color: var(--text);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .theme-toggle svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  nav a {
    color: var(--text-secondary);
  }

  nav a[aria-current] {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 6px;
  }

  footer {
    margin-top: 64px;
    padding: 48px 0;
    border-top: 1px solid var(--hairline);
  }

  .contact {
    display: grid;
    justify-items: start;
    gap: 12px;
    margin-bottom: 48px;
  }

  .contact p {
    margin: 0;
  }

  .contact-title {
    margin: 0;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.4;
  }

  .home {
    font-size: 13px;
    color: var(--text-muted);
  }

  @media (max-width: 800px) {
    header .wrap {
      flex-wrap: wrap;
      height: auto;
      padding-top: 12px;
    }

    .end {
      display: contents;
    }

    .theme-toggle {
      order: 1;
    }

    nav {
      order: 2;
      flex: 0 0 calc(100% + 32px);
      gap: 20px;
      margin: 8px -16px 0;
      padding: 0 16px 12px;
      overflow-x: auto;
      scrollbar-width: none;
      white-space: nowrap;
      mask-image: linear-gradient(to right, var(--text) calc(100% - 32px), transparent);
    }
  }
</style>
